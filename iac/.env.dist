# En dev, doit correspondre au projet déclaré dans
# iac/dev/storage/bigquery/staging_schema.yaml
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1
TWITTER_BEARER_TOKEN=your-bearer-token
TWIKIT_AUTH_TOKEN=your-twikit-auth-token
# Généré par build_search_query(LIGUE1_CONTEXT) — ne pas éditer à la main :
# un test vérifie que cette valeur reste dérivée de THEME_KEYWORDS.
SEARCH_KEYWORDS=(xg OR "expected goals" OR stats OR var OR arbitrage OR "hors jeu" OR mercato OR transfert OR recrue OR tactique OR pressing OR composition) (Ligue1 OR "Ligue 1" OR PSG OR OM OR OL OR LOSC OR ASSE)

# MinIO (S3-compatible local storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=tweets-raw